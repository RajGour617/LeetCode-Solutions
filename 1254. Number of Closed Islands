# Complexity
- Time complexity: $$O(m*n)$$
- Space complexity: $$O(1)$$

# Code
```java []
class Solution {
    int m;
    int n;

    private boolean dfs(int[][] grid, int r, int c) {
        if (r >= m || r < 0 || c >= n || c < 0) { //Out of Bound
            return false;
        }

        if (grid[r][c] == 1) { //Water Found
            return true;
        }

        grid[r][c] = 1; //Mark visited

        boolean left_closed = dfs(grid, r, c - 1);
        boolean right_closed = dfs(grid, r, c + 1);
        boolean up_closed = dfs(grid, r - 1, c);
        boolean down_closed = dfs(grid, r + 1, c);

        return left_closed && right_closed && up_closed && down_closed;
    }

    public int closedIsland(int[][] grid) {
        m = grid.length;
        n = grid[0].length;

        int count = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 0) { //Land Found
                    if (dfs(grid, i, j)) {
                        count++;
                    }
                }
            }
        }

        return count;
    }
}
