# Approach 1:

class Solution {
    public int countCommas(int n) {
        int commas = 0;

        for (int i = 1000; i <= n; i *= 1000) {
            commas += (n - i + 1);
        }

        return commas;
    }
}

--------------------------------------------------------------------------

# Approach 2:

# Time Complexity: O(1)
# Space Complexity: O(1)

class Solution {
    public int countCommas(int n) {
        if (n < 1000)
            return 0;
        
        return n - 1000 + 1;
    }
}
