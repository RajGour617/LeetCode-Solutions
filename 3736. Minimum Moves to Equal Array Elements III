#Time Complexity: O(n)
#Space Complexity: O(1)

class Solution {
    public int minMoves(int[] nums) {
        int maxi = 0;
        
        for(int num : nums) {
            maxi = Math.max(maxi, num);
        }
        
        int moves = 0;
        
        for(int num : nums) {
            moves += (maxi - num);
        }
        
        return moves;
    }
}