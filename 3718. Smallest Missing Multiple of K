- Time Complexity: O(n)
- Space Complexity: O(n)

# Code
class Solution {
    public int missingMultiple(int[] nums, int k) {
        HashSet<Integer> set = new HashSet<>();

        for (int num : nums) {
            set.add(num);
        }

        int i = 1;
        while (set.contains(k * i)) {
            i++;
            ;
        }

        return k * i;
    }
}
