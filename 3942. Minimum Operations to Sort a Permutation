class Solution {
    public int minOperations(int[] nums) {
        int n = nums.length;
        int asc = 0, dsc = 0;

        for (int i = 1; i < n; i++) {
            if (nums[i] == (nums[i - 1] + 1) % n)
                asc++;
            if (nums[i - 1] == (nums[i] + 1) % n)
                dsc++;
        }

        if (asc == n - 1)
            return nums[0] == 0 ? 0 : Math.min(n - nums[0], nums[0] + 2);

        if (dsc == n - 1)
            return Math.min(n - nums[n - 1], nums[n - 1]) + 1;

        return -1;
    }
}
