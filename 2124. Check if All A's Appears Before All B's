# Approach 2:

# Complexity
- Time complexity: O(n)
- Space complexity: O(1)

class Solution {
    public boolean checkString(String s) {
        int n = s.length();

        int lastAPos = -1;
        int firstBPos = n;

        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == 'a') {
                lastAPos = i;
            } else if (s.charAt(i) == 'b' && firstBPos == n) {
                firstBPos = i;
            }
        }

        return lastAPos < firstBPos;
    }
}
