# Approach 1:

# Complexity
- Time complexity: O(n)
- Space complexity: O(1)

# Code
class Solution {
    public boolean checkString(String s) {
        int n = s.length();

        int i = 0;
        while (i < n - 1) {
            if (s.charAt(i) == 'b' && s.charAt(i + 1) == 'a') {
                return false;
            }
            i++;
        }

        return true;
    }
}

